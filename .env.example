# Public HTTPS origin used for every browser artifact URL
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_ORIGINS=https://your-dashboard.example.com,http://localhost:8080

# Durable bounded worker settings
RUN_WORKER_COUNT=2
RUN_QUEUE_POLL_SECONDS=1
RUN_LEASE_SECONDS=180
RUN_MAX_ATTEMPTS=3

# Persist both of these directories in production
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
