# Public HTTPS origin used for every browser artifact URL
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_ORIGINS=https://your-dashboard.example.com,http://localhost:8080

# Durable bounded worker settings
RUN_WORKER_COUNT=2
RUN_QUEUE_POLL_SECONDS=1
RUN_LEASE_SECONDS=180
RUN_MAX_ATTEMPTS=3

# Persist both of these directories in production
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# Speed tuning (all optional, defaults shown)
TRADINGAGENTS_PARALLEL_ANALYSTS=1
TRADINGAGENTS_DATA_CACHE=1
TRADINGAGENTS_DATA_CACHE_TTL=21600

# MCP server for AI assistants. Callers must send this key as
# "Authorization: Bearer <key>" or "X-MCP-Key: <key>". Leave it empty and /mcp
# refuses every request. Generate one with: openssl rand -hex 32
MCP_ACCESS_KEY=
MCP_ENABLED=1
# Empty means every documented tool, including create_analysis and cancel_analysis.
MCP_ALLOWED_TOOLS=
# Process-wide protection against accidental public AI spend.
MCP_CREATE_RUNS_PER_HOUR=12

